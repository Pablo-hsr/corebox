[colors]
; O "99" no início da cor define a transparência (00 a ff)
background = #99282a36
foreground = #f8f8f2
primary = #bd93f9

[bar/minhabarra]
width = 100%
height = 28
offset-x = 1%
offset-y = 10
radius = 10
bottom = false ; Fica no topo

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3
padding = 2
module-margin = 1

font-0 = "sans-serif:size=10;2"
font-1 = "Font Awesome 6 Free:style=Solid:size=10;2"

modules-left = i3
modules-center = date
modules-right = pulseaudio battery

[module/i3]
type = internal/i3
label-focused = %index%
label-focused-background = #44475a
label-focused-underline = ${colors.primary}
label-focused-padding = 2

[module/date]
type = internal/date
interval = 1
date = %H:%M
label =  %date%

[module/pulseaudio]
type = internal/pulseaudio
format-volume =  <label-volume>
label-muted =  mudo

[module/battery]
type = internal/battery
battery = BAT1
adapter = AC
format-charging =  <label-charging>
format-discharging =  <label-discharging>